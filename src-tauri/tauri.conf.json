{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIIDE",
  "version": "0.1.0",
  "identifier": "dev.aiide.app",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "AIIDE", "width": 1200, "height": 760, "minWidth": 760, "minHeight": 460 }], "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" } },
  "bundle": { "active": true, "targets": "all", "icon": [] }
}
